# --- public (sent to browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co

# --- server-only ---
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# Basic auth gate (one shared credential — your wife)
APP_USERNAME=zena
APP_PASSWORD=change-me

# Bearer token shared with GitHub Actions + pg_cron + the Edge Function
CRON_SECRET=long-random-string

# Optional: override the configured admin path (defaults to /admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=different-password
